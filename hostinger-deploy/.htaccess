# TheGreensolve (thegreensolve.com) — Apache / Hostinger configuration
#
# This folder is a fully static build. There is no Node.js process:
#   /                     -> index.html, the Baseline carbon platform (one self-contained page)
#   /blog, /blog/...      -> pre-rendered React pages (real HTML, good for search engines)
#   /auth, /netlow/...    -> React app shells that boot in the browser and talk to Supabase
#
# Anything that is not a real file falls back to the Baseline page, which is how
# the site behaved before. /api/ is left alone so it returns a genuine 404.

Options -Indexes
DirectoryIndex index.html
# Serve /blog straight from /blog/index.html instead of bouncing to /blog/,
# so the URL keeps matching the canonical link inside each page.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Use the bare domain (www.thegreensolve.com -> thegreensolve.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Server-only endpoints do not exist on static hosting: let them 404 honestly
  # instead of answering with a page the caller would try to parse.
  RewriteRule ^api/ - [R=404,L]

  # Serve real files as they are
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Pre-rendered page for this URL, e.g. /blog/faq -> /blog/faq/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Everything else: the Baseline page
  RewriteRule ^ /index.html [L]
</IfModule>

# HTML is always revalidated; fingerprinted assets can be cached for a year
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
