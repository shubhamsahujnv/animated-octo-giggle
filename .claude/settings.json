{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_em_dash.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking for em dashes..."
          }
        ]
      }
    ]
  }
}
