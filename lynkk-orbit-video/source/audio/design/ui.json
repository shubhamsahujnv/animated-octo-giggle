 "rules": [
  {
   "name": "ui.tick",
   "match": {
    "kind": "tick",
    "id": "^ring1:title:"
   },
   "pool": "ui.tick",
   "mode": "cycle",
   "gain_db": 3,
   "jitter_db": 1.0,
   "pan": 0,
   "align": "attack",
   "_doc": "raised for the louder, punchier v3 track (v3 first render: read -1..-7 dB masked)"
  },
  {
   "name": "ui.pop",
   "match": {
    "kind": "pop"
   },
   "pool": "ui.pop",
   "mode": "cycle",
   "gain_db": -4,
   "pitch_ramp": [
    0,
    2
   ],
   "pan": "cue",
   "pan_scale": 0.4,
   "align": "attack"
  }
 ]
}